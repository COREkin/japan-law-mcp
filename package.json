{
  "name": "japan-law-mcp",
  "version": "1.0.0",
  "description": "MCP server for Japanese law - e-Gov API v2 with citation verification, impact mapping, time travel diff, and action planning",
  "main": "dist/index.js",
  "bin": {
    "japan-law-mcp": "dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "japanese-law",
    "e-gov",
    "legal",
    "ai",
    "llm",
    "claude"
  ],
  "author": "金 棟植 (Dongsik Kim) <aaaa8757@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/COREkin/japan-law-mcp.git"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "undici": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
